<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Regenerates the app icons and the README hero images from code.
    Usage (see Program.cs): dotnet run with the argument icons, hero or all.
      icons → src/AudioCarousel/Resources/*.ico
      hero  → docs/images/hero-*.png
    Needs only .NET and Microsoft Edge (preinstalled on Windows 10/11), which
    renders the SVG/HTML headlessly. UI labels, glyphs and hotkey text come
    straight from the app assembly, so the images can't drift from the app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioCarousel\AudioCarousel.csproj" />
  </ItemGroup>
</Project>
